# Oniva Environment Configuration
# Copy this file to .env and replace placeholder values
#
# IMPORTANT: For production deployments, generate secure secrets using:
#   python scripts/generate_secrets.py
#
# Store production secrets in a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# NEVER commit actual secrets to version control!

# ============================================================================
# ENVIRONMENT
# ============================================================================
# Options: development, staging, production
# Security validation only enforced when ENVIRONMENT=production
ENVIRONMENT=development
DEBUG=true

# ============================================================================
# SECURITY CONFIGURATION (REQUIRED FOR PRODUCTION)
# ============================================================================
# Generate all security values using: python scripts/generate_secrets.py
# The application will CRASH on startup if production uses default values!

# JWT signing key - minimum 32 characters, cryptographically random
# WARNING: Changing SECRET_KEY invalidates all existing user sessions
SECRET_KEY=GENERATE_WITH_SCRIPT__run__python_scripts_generate_secrets_py

# Encryption salt for API key storage - hex-encoded 32 bytes
# WARNING: Changing ENCRYPTION_SALT makes existing API keys unreadable
ENCRYPTION_SALT=GENERATE_WITH_SCRIPT__run__python_scripts_generate_secrets_py

# JWT token expiration in minutes (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# CORS allowed origins - comma-separated list
# Development: http://localhost:3000,http://localhost:3001
# Production: https://your-frontend-domain.com (NO WILDCARDS!)
# WARNING: Using * in production creates CSRF vulnerabilities
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection - use generated password in production
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/oniva

# Postgres superuser password (for migrations)
POSTGRES_PASSWORD=GENERATE_WITH_SCRIPT__run__python_scripts_generate_secrets_py

# Application database user credentials (for RLS enforcement)
APP_DATABASE_USER=oniva_app
APP_DATABASE_PASSWORD=GENERATE_WITH_SCRIPT__run__python_scripts_generate_secrets_py

# DBOS Configuration (for durable workflows)
DBOS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oniva

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_URL=redis://localhost:6379

# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================
# Provider options: openrouter, openai, anthropic
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=openai/gpt-4o-mini

# OpenRouter Configuration
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ============================================================================
# API KEYS (Store in secrets manager in production)
# ============================================================================
# Set the API key(s) for your chosen LLM provider(s)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Skills API Keys (optional - for enhanced capabilities)
ALPHA_VANTAGE_API_KEY=      # Market data
TAVILY_API_KEY=             # Web search
SERPAPI_API_KEY=            # Alternative web search
POLYGON_API_KEY=            # Premium market data

# External API Keys (for workflow HTTP nodes - auto-injected by server)
EXA_API_KEY=                # Exa.ai web search / DeepWork
PERPLEXITY_API_KEY=         # Perplexity AI deep research

# ============================================================================
# ARCHITECTURE 2.0 FEATURE FLAGS
# ============================================================================
# Phases 1-3 ENABLED by default as of Jan 16, 2026
# Phases 4-5 remain disabled (not yet implemented)

# Phase 1: Durable Workflows (DBOS checkpointing) - ENABLED
# Provides zero data loss crash recovery and workflow replay
USE_DURABLE_WORKFLOWS=true

# Phase 2: Simplified Memory Architecture - ENABLED
# Enables pre-warmed volumes, filesystem sessions, and 7-year artifact retention
USE_VOLUMES=true
USE_SESSION_FILESYSTEM=true
USE_ARTIFACTS=true

# Phase 3: State Machine (deterministic execution) - ENABLED
# Provides tool masking and deterministic agent behavior
USE_STATE_MACHINE=true

# Phase 4: Cost Optimization (KVFlow caching) - NOT IMPLEMENTED
USE_KVFLOW_CACHING=false
CACHE_STRATEGY=provider

# Phase 5: Ecosystem (Agent-to-Agent protocol) - NOT IMPLEMENTED
ENABLE_A2A=false

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================
# Volumes (pre-warmed input data)
VOLUMES_BASE_PATH=./volumes
VOLUMES_USE_S3=false
VOLUMES_S3_BUCKET=
VOLUMES_S3_PREFIX=volumes/

# Artifacts (persistent outputs with compliance retention)
ARTIFACTS_BASE_PATH=./artifacts
ARTIFACTS_USE_S3=false
ARTIFACTS_S3_BUCKET=
ARTIFACTS_S3_PREFIX=artifacts/
ARTIFACTS_RETENTION_DAYS=2555  # 7 years for compliance

# Sessions
SESSION_BASE_PATH=./sessions
SESSION_MAX_SIZE_GB=10

# ============================================================================
# OBSERVABILITY (Phase 1 & P2.4)
# ============================================================================
ENABLE_METRICS=true
LOGFIRE_TOKEN=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=oniva
OTEL_EXPORTER_OTLP_ENDPOINT=

# Braintrust Observability (P2.4)
# Enterprise AI observability with built-in evaluation, dashboards, and alerting
# Get API key from: https://www.braintrust.dev
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=oniva
BRAINTRUST_ENABLED=false
BRAINTRUST_TRACE_AI_ONLY=true

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT=100  # requests per minute

# ============================================================================
# SKILLS CONFIGURATION
# ============================================================================
ENABLE_SANDBOX=false  # Enable Docker sandboxing for code execution

# ============================================================================
# MCP CONNECTORS
# ============================================================================
# Linear MCP (OAuth handled by MCP protocol - no API key needed)
# See .mcp.json for Linear configuration
# See LINEAR_MCP_SETUP.md for setup instructions

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================================================
# Before deploying to production, ensure:
#
# 1. [ ] Run: python scripts/generate_secrets.py
# 2. [ ] Store generated secrets in secrets manager (AWS, Vault, etc.)
# 3. [ ] Set ENVIRONMENT=production
# 4. [ ] Set DEBUG=false
# 5. [ ] Configure CORS_ORIGINS with exact frontend domain(s)
# 6. [ ] Update DATABASE_URL with secure credentials
# 7. [ ] Enable HTTPS/TLS for all connections
# 8. [ ] Test application startup validates secrets correctly
# 9. [ ] Set up monitoring alerts for security events
# 10. [ ] Document secret rotation schedule (every 90 days recommended)
#
# See Docs/DEPLOYMENT.md for complete security checklist
