# Oniva Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ===========================================
# REQUIRED SETTINGS - Docker Compose
# ===========================================

# PostgreSQL Database
POSTGRES_DB=oniva
POSTGRES_USER=oniva
POSTGRES_PASSWORD=CHANGE_ME_generate_secure_password

# docker-compose assembles DATABASE_URL / SYSTEM_DATABASE_URL / MIGRATION_DATABASE_URL for the
# backend container from the three passwords here (POSTGRES_PASSWORD = schema owner,
# APP_DATABASE_PASSWORD = oniva_app, SYSTEM_DATABASE_PASSWORD = oniva_system). Use URL-safe
# passwords (hex / token_urlsafe). The two role passwords are applied on FIRST postgres boot.
# The URL below is only used when running the backend directly on the host (uvicorn):
DATABASE_URL=postgresql+asyncpg://oniva_app:CHANGE_ME_generate_secure_password@localhost:5432/oniva

# Redis (SECURITY: Password required)
REDIS_PASSWORD=CHANGE_ME_generate_secure_password
REDIS_URL=redis://:CHANGE_ME_generate_secure_password@redis:6379

# Security (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=CHANGE_ME_generate_32_char_minimum_secret

# Encryption salt (generate with: python -c "import secrets; print(secrets.token_hex(32))")
ENCRYPTION_SALT=CHANGE_ME_generate_64_char_hex_salt

# RLS Application Role Password (CRITICAL for multi-tenant security)
# In production, this MUST be set to a secure value (min 16 chars)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_DATABASE_PASSWORD=CHANGE_ME_in_production
SYSTEM_DATABASE_PASSWORD=CHANGE_ME_in_production

# Three DB roles (U9). Passwords are set out-of-band: ALTER ROLE <role> PASSWORD '...'
#   DATABASE_URL            -> oniva_app    (NOSUPERUSER NOBYPASSRLS; request path; startup refuses otherwise)
#   SYSTEM_DATABASE_URL     -> oniva_system (BYPASSRLS; scheduler, webhooks, startup recovery, pre-tenant auth)
#   MIGRATION_DATABASE_URL  -> schema owner (alembic; AUTO_MIGRATE=true in dev, false in prod)
# SYSTEM_DATABASE_URL=postgresql+asyncpg://oniva_system:CHANGE_ME@postgres:5432/oniva
# MIGRATION_DATABASE_URL=postgresql+asyncpg://oniva:CHANGE_ME@postgres:5432/oniva
# AUTO_MIGRATE=false
# STALE_JOB_THRESHOLD_SECONDS=3600

# ===========================================
# ENVIRONMENT SETTINGS
# ===========================================

# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (MUST be false in production)
DEBUG=true

# CORS allowed origins (comma-separated)
# Development:
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Production example:
# CORS_ORIGINS=https://app.oniva.ai,https://admin.oniva.ai

# ===========================================
# LLM API KEYS (at least one required)
# ===========================================

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (recommended - provides access to multiple models)
OPENROUTER_API_KEY=sk-or-...

# Google AI (Gemini)
GOOGLE_API_KEY=

# ===========================================
# OPTIONAL SETTINGS
# ===========================================

# Default LLM provider: openai, anthropic, openrouter
DEFAULT_LLM_PROVIDER=openrouter

# Default model
DEFAULT_LLM_MODEL=openai/gpt-4o-mini

# Rate limiting
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT=100

# JWT token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ===========================================
# OBSERVABILITY (Optional)
# ===========================================

# LangSmith (LangChain)
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=oniva

# Braintrust
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=oniva
BRAINTRUST_ENABLED=false

# ===========================================
# EXTERNAL INTEGRATIONS (Optional)
# ===========================================

# Market data
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=

# Web search
TAVILY_API_KEY=
EXA_API_KEY=
PERPLEXITY_API_KEY=

# ===========================================
# CONNECTORS (Optional)
# ===========================================

# Linear
# LINEAR_API_KEY=lin_api_...

# ServiceNow
# SERVICENOW_INSTANCE=dev12345
# SERVICENOW_USERNAME=admin
# SERVICENOW_PASSWORD=...

# ===========================================
# ENGINE (durable agent runtime; optional)
# ===========================================
# Three distinct secrets, each >= 32 chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ENGINE_GATEWAY_TOKEN guards /internal (engine -> backend; mounted only when set).
# ENGINE_SERVICE_TOKEN is what the backend presents to the engine (backend -> engine).
# ENGINE_GATEWAY_TOKEN_PREVIOUS is accepted during rotation only.
# ENGINE_GATEWAY_TOKEN=
# ENGINE_GATEWAY_TOKEN_PREVIOUS=
# ENGINE_SERVICE_TOKEN=
# ENGINE_URL=http://engine:8080
# ENGINE_SESSION_ID=oniva-default
# ENABLE_ENGINE_API=false
# ENGINE_DB_PASSWORD=
